# 应用配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== 应用基础配置 ====================
APP_NAME="PathFinder API"
DEBUG=True

# ==================== 数据库配置 ====================

# 数据库类型：sqlite | supabase
DB_TYPE=sqlite

# SQLite 配置（开发环境）
SQLITE_PATH=./database.sqlite

# Supabase 配置（生产环境 - 未来使用）
# 从 Supabase Dashboard 获取这些值
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ==================== 认证配置 ====================

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ==================== CORS 配置 ====================

# 允许的前端域名（生产环境应指定具体域名）
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ==================== AI 服务配置 ====================

# OpenAI API Key（如果需要真实 AI 功能）
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo

# ==================== 切换到 Supabase 的步骤 ====================
# 
# 1. 在 Supabase 创建项目：https://app.supabase.com
# 2. 复制项目 URL 和 API keys
# 3. 在 Supabase Dashboard 中创建表结构（参考 database.py）
# 4. 修改 .env 文件：
#    DB_TYPE=supabase
#    SUPABASE_URL=https://xxx.supabase.co
#    SUPABASE_SERVICE_KEY=your-service-key
# 5. 重启服务
# 
# 注意：首次切换到 Supabase 前，需要实现 adapters/supabase.py
