# 应用配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== 应用基础配置 ====================
APP_NAME="PathFinder API"
DEBUG=True

DATABASE_URL=

# ==================== 认证配置 ====================

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ==================== CORS 配置 ====================

# 允许的前端域名（生产环境应指定具体域名）
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ==================== AI 服务配置 ====================

# OpenAI API Key（如果需要真实 AI 功能）
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo
