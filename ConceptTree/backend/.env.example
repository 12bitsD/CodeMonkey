# =============================================================================
# backend/.env — ConceptTree Backend Configuration
# =============================================================================
# HOW TO USE
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked "REQUIRED".
#   3. Never commit .env to version control — it contains secrets.
#
# ARCHITECTURE QUICK MAP
#   FastAPI app → PostgreSQL (Supabase) for persistent data storage
#              → Kimi LLM (primary AI) for concept-tree generation
#              → OpenAI (fallback AI, optional) when Kimi is unavailable
#
# Primary reader: Backend developer setting up local dev or a CI/CD pipeline.
# =============================================================================


# ==================== Application Basics =====================================
# APP_NAME appears in API response headers and auto-generated docs (/docs).
# Set DEBUG=False in production — True exposes full tracebacks in HTTP responses.
APP_NAME="PathFinder API"
DEBUG=True


# ==================== Database ===============================================
# DATABASE_URL  — full Postgres connection string (REQUIRED).
# DATABASE_SCHEMA — Postgres schema to use (leave empty to use "public").
#
# Format:
#   postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# Local dev (Docker Compose from this repo):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
#
# Supabase (production / staging):
#   Get the connection string from: Supabase Dashboard → Project → Settings → Database
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# SECURITY: Never commit a real password — store it in a secrets manager in production.
DATABASE_URL=
DATABASE_SCHEMA=


# ==================== Authentication (JWT) ====================================
# JWT tokens authenticate every API request after login.
#
# JWT_SECRET_KEY  — random secret used to sign tokens (REQUIRED; change before deploying).
#                   Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_ALGORITHM   — signing algorithm; HS256 is the standard safe default.
# JWT_EXPIRE_DAYS — how many days a token stays valid before forcing re-login.
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7


# ==================== CORS (Cross-Origin Requests) ===========================
# Controls which browser origins may call this API.
# Uncomment and restrict to your actual frontend URL in production — leaving it
# open allows any origin to make authenticated requests to your API.
#
# Local dev:   CORS_ORIGINS=["http://localhost:3000"]
# Production:  CORS_ORIGINS=["https://app.yourcompany.com"]
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]


# ==================== AI Service — Primary LLM (Kimi) ========================
# The backend calls Kimi to generate and expand concept trees.
#
# LLM_PROVIDER    — internal identifier; keep as "kimi".
# LLM_API_KEY     — get your key at https://platform.moonshot.cn/  (REQUIRED).
# LLM_BASE_URL    — Kimi's OpenAI-compatible endpoint; do not change unless Moonshot updates it.
# LLM_MODEL       — model ID; kimi-k2-5 is the current production default.
# LLM_TIMEOUT     — seconds to wait for a single API response before aborting.
# LLM_MAX_RETRIES — how many times to retry a failed call before returning an error.
# LLM_TEMPERATURE — creativity: 0 = deterministic, 1 = more varied (0.7 is the safe default).
LLM_PROVIDER=kimi
LLM_API_KEY=your_kimi_api_key_here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2-5
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7


# ==================== AI Service — Fallback LLM (OpenAI, optional) ===========
# When a Kimi call fails or times out, the backend can retry via OpenAI.
# Set LLM_FALLBACK_ENABLED=false to disable this behaviour entirely.
#
# LLM_FALLBACK_API_KEY  — get from https://platform.openai.com/api-keys
# LLM_FALLBACK_BASE_URL — leave empty to use the official OpenAI endpoint.
# LLM_FALLBACK_MODEL    — gpt-4o-mini balances cost and quality for this use case.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_API_KEY=your_openai_key_here
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=gpt-4o-mini
