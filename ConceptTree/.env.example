# Docker Compose runtime settings for production/staging.
# Copy this file to .env on the server and fill real secrets there.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

APP_NAME=LearningMaster API
APP_VERSION=1.0.0
DEBUG=false

# Local Docker postgres:
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/postgres
# Supabase example:
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_SCHEMA=public
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_IN_TX_TIMEOUT_MS=10000

JWT_SECRET_KEY=replace_with_a_64_char_or_longer_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# For same-domain Docker deployment through frontend nginx, this can stay empty.
# For split frontend/backend domains, use a comma-separated list without spaces.
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

LLM_PROVIDER=kimi
LLM_API_KEY=your_moonshot_api_key_here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k3
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_REASONING_EFFORT=low
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=gpt-4o-mini

# Used when deep learn image_type == "dalle".
IMAGE_PROVIDER=openrouter
IMAGE_API_KEY=your_openrouter_api_key_here
IMAGE_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL=openai/gpt-5.4-image-2
IMAGE_TIMEOUT=300

SEARCH_ENABLED=false
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_TIMEOUT=8
SEARCH_MAX_RESULTS=5
SEARCH_ALLOWED_DOMAINS=
SEARCH_CACHE_TTL_SECONDS=1800

# Required only if image storage/uploads use Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Frontend is built to call same-domain /api by default.
VITE_API_BASE_URL=/api
